<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.StockGroupMapper">

    <resultMap type="StockGroup" id="StockGroupResult">
        <result property="id"          column="id"          />
        <result property="groupName"   column="group_name"  />
        <result property="createBy"    column="create_by"   />
        <result property="createTime"  column="create_time" />
        <result property="updateBy"    column="update_by"   />
        <result property="updateTime"  column="update_time" />
        <result property="remark"      column="remark"      />
    </resultMap>

    <sql id="selectGroupVo">
        select id, group_name, create_by, create_time, update_by, update_time, remark
        from stock_group
    </sql>

    <select id="selectGroupList" parameterType="StockGroup" resultMap="StockGroupResult">
        <include refid="selectGroupVo"/>
        <where>
            <if test="groupName != null and groupName != ''">
                AND group_name like concat('%', #{groupName}, '%')
            </if>
        </where>
        order by update_time desc, id desc
    </select>

    <select id="selectGroupById" parameterType="Long" resultMap="StockGroupResult">
        <include refid="selectGroupVo"/>
        where id = #{id}
    </select>

    <insert id="insertGroup" parameterType="StockGroup" useGeneratedKeys="true" keyProperty="id">
        insert into stock_group (
        <if test="groupName != null and groupName != ''">group_name,</if>
        <if test="remark != null and remark != ''">remark,</if>
        <if test="createBy != null and createBy != ''">create_by,</if>
        create_time, update_time
        ) values (
        <if test="groupName != null and groupName != ''">#{groupName},</if>
        <if test="remark != null and remark != ''">#{remark},</if>
        <if test="createBy != null and createBy != ''">#{createBy},</if>
        sysdate(), sysdate()
        )
    </insert>

    <update id="updateGroup" parameterType="StockGroup">
        update stock_group
        <set>
            <if test="groupName != null and groupName != ''">group_name = #{groupName},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <update id="touchGroup">
        update stock_group set update_time = sysdate() where id = #{groupId}
    </update>

    <delete id="deleteGroupById" parameterType="Long">
        delete from stock_group where id = #{id}
    </delete>

    <delete id="deleteGroupByIds" parameterType="Long">
        delete from stock_group where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <insert id="insertGroupStocks">
        insert into stock_group_stock (group_id, stock_code) values
        <foreach item="stockCode" collection="stockCodes" separator=",">
            (#{groupId}, #{stockCode})
        </foreach>
    </insert>

    <insert id="insertGroupStocksIgnore">
        insert ignore into stock_group_stock (group_id, stock_code) values
        <foreach item="stockCode" collection="stockCodes" separator=",">
            (#{groupId}, #{stockCode})
        </foreach>
    </insert>

    <delete id="deleteGroupStocks">
        delete from stock_group_stock where group_id = #{groupId} and stock_code in
        <foreach item="stockCode" collection="stockCodes" open="(" separator="," close=")">
            #{stockCode}
        </foreach>
    </delete>

    <delete id="deleteGroupStocksByGroupId" parameterType="Long">
        delete from stock_group_stock where group_id = #{groupId}
    </delete>

    <!-- 批量查询股票所属分组名称（按 stock_code IN 列表） -->
    <select id="selectGroupNamesByStockCodes" resultType="java.util.HashMap">
        select sgs.stock_code as stockCode, g.group_name as groupName
        from stock_group_stock sgs
        inner join stock_group g on sgs.group_id = g.id
        where sgs.stock_code in
        <foreach item="stockCode" collection="stockCodes" open="(" separator="," close=")">
            #{stockCode}
        </foreach>
        order by sgs.stock_code, g.update_time desc, g.id desc
    </select>

    <select id="selectExpiredDatedGroups" resultMap="StockGroupResult">
        select id, group_name, create_by, create_time, update_by, update_time, remark
        from stock_group
        where group_name regexp '_[0-9]{4}-[0-9]{2}-[0-9]{2}(_上升|_震荡)?$'
          and create_time &lt; date_sub(curdate(), interval #{days} day)
        order by create_time asc
    </select>

</mapper>