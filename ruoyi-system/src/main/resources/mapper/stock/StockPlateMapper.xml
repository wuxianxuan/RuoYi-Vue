<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.StockPlateMapper">

    <resultMap type="StockPlate" id="StockPlateResult">
        <result property="id"          column="id"          />
        <result property="plateName"   column="plate_name"  />
        <result property="plateType"   column="plate_type"  />
        <result property="plateCode"   column="plate_code"  />
        <result property="sortOrder"   column="sort_order"  />
        <result property="focusFlag" column="focus_flag" />
        <result property="createBy"    column="create_by"   />
        <result property="createTime"  column="create_time" />
        <result property="updateBy"    column="update_by"   />
        <result property="updateTime"  column="update_time" />
        <result property="remark"      column="remark"      />
    </resultMap>

    <sql id="selectPlateVo">
        select id, plate_name, plate_type, plate_code, sort_order, focus_flag,
               create_by, create_time, update_by, update_time, remark
        from stock_plate
    </sql>

    <select id="selectPlateList" parameterType="StockPlate" resultMap="StockPlateResult">
        <include refid="selectPlateVo"/>
        <where>
            <if test="plateName != null and plateName != ''">
                AND plate_name like concat('%', #{plateName}, '%')
            </if>
            <if test="plateType != null and plateType != ''">
                AND plate_type = #{plateType}
            </if>
            <if test="plateCode != null and plateCode != ''">
                AND plate_code like concat('%', #{plateCode}, '%')
            </if>
            <if test="focusFlag != null">
                AND focus_flag = #{focusFlag}
            </if>
        </where>
        order by update_time desc, id desc
    </select>

    <select id="selectPlateById" parameterType="Long" resultMap="StockPlateResult">
        <include refid="selectPlateVo"/>
        where id = #{id}
    </select>

    <select id="selectIndustryPlateList" resultMap="StockPlateResult">
        <include refid="selectPlateVo"/>
        where plate_type = 'INDUSTRY'
        order by sort_order asc, id asc
    </select>

    <select id="selectConceptPlateList" resultMap="StockPlateResult">
        <include refid="selectPlateVo"/>
        where plate_type = 'CONCEPT'
        order by sort_order asc, id asc
    </select>

    <insert id="insertPlate" parameterType="StockPlate" useGeneratedKeys="true" keyProperty="id">
        insert into stock_plate (
        <if test="plateName != null and plateName != ''">plate_name,</if>
        <if test="plateType != null and plateType != ''">plate_type,</if>
        <if test="plateCode != null and plateCode != ''">plate_code,</if>
        <if test="sortOrder != null">sort_order,</if>
        <if test="focusFlag != null">focus_flag,</if>
        <if test="remark != null and remark != ''">remark,</if>
        <if test="createBy != null and createBy != ''">create_by,</if>
        create_time
        ) values (
        <if test="plateName != null and plateName != ''">#{plateName},</if>
        <if test="plateType != null and plateType != ''">#{plateType},</if>
        <if test="plateCode != null and plateCode != ''">#{plateCode},</if>
        <if test="sortOrder != null">#{sortOrder},</if>
        <if test="focusFlag != null">#{focusFlag},</if>
        <if test="remark != null and remark != ''">#{remark},</if>
        <if test="createBy != null and createBy != ''">#{createBy},</if>
        sysdate()
        )
    </insert>

    <update id="updatePlate" parameterType="StockPlate">
        update stock_plate
        <set>
            <if test="plateName != null and plateName != ''">plate_name = #{plateName},</if>
            <if test="plateType != null and plateType != ''">plate_type = #{plateType},</if>
            <if test="plateCode != null">plate_code = #{plateCode},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="focusFlag != null">focus_flag = #{focusFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <!-- 批量修改板块的重点关注标记 -->
    <update id="updateFocusFlagByIds">
        update stock_plate set focus_flag = #{focusFlag}, update_time = sysdate()
        where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <delete id="deletePlateById" parameterType="Long">
        delete from stock_plate where id = #{id}
    </delete>

    <delete id="deletePlateByIds" parameterType="Long">
        delete from stock_plate where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 查询所有已存在股票关联的板块代码（去重） -->
    <select id="selectDistinctPlateCodesWithStocks" resultType="String">
        select distinct plate_code from stock_plate_stock
    </select>

    <!-- 板块下的关联股票 -->
    <select id="selectPlateStocksByPlateCode" parameterType="String" resultMap="com.ruoyi.system.mapper.StockMapper.StockResult">
        select s.id, s.stock_code, s.stock_name, s.market,
               s.current_price, s.change_rate, s.turnover_rate, s.volume_ratio, s.turnover_amount,
               s.create_by, s.create_time, s.update_by, s.update_time, s.remark
        from stock s
                 inner join stock_plate_stock sps on s.stock_code = sps.stock_code
        where sps.plate_code = #{plateCode}
        order by s.id desc
    </select>

    <!-- 批量添加板块-股票关联 -->
    <insert id="insertPlateStocks">
        insert into stock_plate_stock (plate_code, stock_code) values
        <foreach item="stockCode" collection="stockCodes" separator=",">
            (#{plateCode}, #{stockCode})
        </foreach>
    </insert>

    <!-- 批量删除板块-股票关联 -->
    <delete id="deletePlateStocks">
        delete from stock_plate_stock where plate_code = #{plateCode} and stock_code in
        <foreach item="stockCode" collection="stockCodes" open="(" separator="," close=")">
            #{stockCode}
        </foreach>
    </delete>

    <!-- 删除板块下所有股票关联 -->
    <delete id="deletePlateStocksByPlateCode" parameterType="String">
        delete from stock_plate_stock where plate_code = #{plateCode}
    </delete>

    <!-- 根据股票代码批量匹配 -->
    <select id="selectStocksByCodeBatch" resultMap="com.ruoyi.system.mapper.StockMapper.StockResult">
        select s.id, s.stock_code, s.stock_name, s.market,
        s.create_by, s.create_time, s.update_by, s.update_time, s.remark
        from stock s
        where s.stock_code in
        <foreach item="stockCode" collection="stockCodes" open="(" separator="," close=")">
            #{stockCode}
        </foreach>
    </select>

    <!-- 按名称+类型精确查询板块 -->
    <select id="selectPlateByNameAndType" resultMap="StockPlateResult">
        <include refid="selectPlateVo"/>
        where plate_name = #{plateName} and plate_type = #{plateType}
        limit 1
    </select>

    <!-- 批量查询概念关联 -->
    <select id="selectConceptNamesByStockCodes" resultType="java.util.HashMap">
        select sps.stock_code as stockCode, sp.plate_name as conceptName
        from stock_plate_stock sps
        inner join stock_plate sp on sps.plate_code = sp.plate_code
        where sp.plate_type = 'CONCEPT'
        and sps.stock_code in
        <foreach item="stockCode" collection="stockCodes" open="(" separator="," close=")">
            #{stockCode}
        </foreach>
        order by sps.stock_code, sp.sort_order asc
    </select>

    <!-- 批量查询行业关联（只取叶子行业名） -->
    <select id="selectIndustryNamesByStockCodes" resultType="java.util.HashMap">
        select sps.stock_code as stockCode, sp.plate_name as industryName
        from stock_plate_stock sps
        inner join stock_plate sp on sps.plate_code = sp.plate_code
        where sp.plate_type = 'INDUSTRY'
        and sps.stock_code in
        <foreach item="stockCode" collection="stockCodes" open="(" separator="," close=")">
            #{stockCode}
        </foreach>
        order by sps.stock_code, sp.sort_order asc
    </select>

</mapper>